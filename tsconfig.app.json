{
  // Typecheck for Vue app sources under src/
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    // Keep false: Vue optional props clash with exactOptionalPropertyTypes
    "exactOptionalPropertyTypes": false,
    "types": ["vite/client", "vitest/globals"],
    "baseUrl": ".",
    // FSD layer aliases (keep in sync with vite.config.ts)
    "paths": {
      "@app/*": ["src/app/*"],
      "@pages/*": ["src/pages/*"],
      "@widgets/*": ["src/widgets/*"],
      "@features/*": ["src/features/*"],
      "@entities/*": ["src/entities/*"],
      "@shared/*": ["src/shared/*"]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["env.d.ts", "src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "src/**/*.d.ts"],
  // Tests and stories typechecked via their own runners / tooling
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts", "src/**/*.stories.ts"]
}
